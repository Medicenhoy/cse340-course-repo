<%- include('partials/header') %>
<main class="project-details">
    <img
        src="/images/<%= project.logo_filename %>"
        alt="<%= project.organization_name %> logo"
        class="org-logo-corner"
    >
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <p><strong>Date:</strong>
        <%= new Date(project.date).toLocaleDateString('en-US', {
            year: 'numeric', month: 'long', day: 'numeric'
        }) %>
    </p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <p><strong>Categories:</strong>
        <% categories.forEach(category => { %>
        <a href="/category/<%= category.category_id %>" class="tag"><%= category.name %></a>
        <% }) %>
    </p>
    <% if (isAdmin) { %>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>